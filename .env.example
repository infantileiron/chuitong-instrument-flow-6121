COMPOSE_PROJECT_NAME=instrument-flows
FRONTEND_PORT=18281
BACKEND_PORT=19281
DB_PORT=17781
NETWORK_SUBNET=10.221.212.0/24
MYSQL_DATABASE=instrument_flows
MYSQL_USER=ensemble
MYSQL_PASSWORD=ensemble_local_pass
MYSQL_ROOT_PASSWORD=root_local_pass
JWT_SECRET=ct-demo-session-change-at-deployment
LEDGER_SECRET=ct-demo-ledger-change-before-first-signature
SEED_DEMO=true
# 每个运行按冻结快照切成的单批凭据上限，中断后从首个未完成批次续跑
PIVOT_BATCH_SIZE=5
# 运行心跳超过该秒数未更新即视为僵死，分析员可在透视页接手并推进 worker 纪元
RUN_STALE_SECONDS=30
